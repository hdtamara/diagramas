{
  "name": "diagramas-de-flujo",
  "version": "1.2.0",
  "private": true,
  "description": "Armar, modificar y ejecutar diagramas de flujo en el navegador",
  "scripts": {
    "serve": "node tests/serve.js",
    "test": "node tests/core.test.js && node tests/export.test.js && node tests/store.test.js && node tests/pycode.test.js",
    "test:core": "node tests/core.test.js",
    "test:export": "node tests/export.test.js",
    "test:store": "node tests/store.test.js",
    "test:ui": "node tests/run-ui-tests.js",
    "test:ui:movil": "node tests/run-ui-tests.js --width=420 --height=860",
    "test:ui:publicado": "node tests/run-ui-tests.js --url=https://diagramas.pages.dev",
    "deploy": "wrangler pages deploy . --project-name=diagramas --branch=main --commit-dirty=true",
    "test:py": "node tests/pycode.test.js"
  }
}
